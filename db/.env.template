# ============================================================================
# Database Configuration - PostgreSQL
# ============================================================================

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=ai_awards
DB_SSL=false

# Connection Pool Settings
DB_POOL_SIZE=20
DB_STATEMENT_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ============================================================================
# Application Configuration
# ============================================================================

# Environment
NODE_ENV=development

# Server
PORT=3000
API_BASE_URL=http://localhost:3000

# ============================================================================
# Jira Integration
# ============================================================================

JIRA_API_URL=https://your-domain.atlassian.net
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
JIRA_USERNAME=your-email@example.com

# Jira polling interval (milliseconds)
JIRA_POLL_INTERVAL=3600000

# ============================================================================
# AI Vision Model Configuration
# ============================================================================

# Primary AI Provider (google-vision, azure-cv, or other)
AI_PROVIDER_PRIMARY=google-vision
AI_PROVIDER_SECONDARY=azure-cv

# Google Cloud Vision API
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_API_KEY=your_google_api_key_here

# Azure Computer Vision API
AZURE_CV_ENDPOINT=https://your-region.api.cognitive.microsoft.com
AZURE_CV_API_KEY=your_azure_cv_key_here

# AI Model Configuration
AI_MODEL_VERSION=vision-api-v1.0
AI_EVALUATION_TIMEOUT=120000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_INITIAL=360000

# ============================================================================
# Notification Configuration
# ============================================================================

# Email Service (sendgrid, mailgun, or smtp)
NOTIFICATION_EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=awards@example.com

# SMTP Configuration (if using direct SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
SMTP_FROM=awards@example.com

# In-App Notifications
NOTIFICATION_IN_APP_ENABLED=true

# Notification Deduplication Window (milliseconds)
NOTIFICATION_DEDUP_WINDOW=60000

# ============================================================================
# Cache Configuration
# ============================================================================

# Redis Cache
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTLs (seconds)
CACHE_LEADERBOARD_TTL=3600
CACHE_STATS_TTL=86400
CACHE_DASHBOARD_TTL=7200

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/ai-awards.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=10

# ============================================================================
# Audit Trail Configuration
# ============================================================================

# Audit log retention (days)
AUDIT_RETENTION_DAYS=730

# Audit log batch size (number of events before flush)
AUDIT_BATCH_SIZE=100

# ============================================================================
# Performance Tuning
# ============================================================================

# Maximum concurrent AI evaluations
MAX_CONCURRENT_EVALUATIONS=5

# Media file cache location
MEDIA_CACHE_DIR=/tmp/ai-awards-media-cache
MEDIA_CACHE_MAX_SIZE=5000000000

# ============================================================================
# Award Calculation Schedule
# ============================================================================

# Weekly award calculation (cron format)
AWARD_WEEKLY_SCHEDULE=0 23 * * 0

# Monthly award calculation (cron format)
AWARD_MONTHLY_SCHEDULE=0 23 28-31 * *

# ============================================================================
# Feature Flags
# ============================================================================

FEATURE_AI_EVALUATION_ENABLED=true
FEATURE_WEEKLY_AWARDS_ENABLED=true
FEATURE_MONTHLY_AWARDS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_LEADERBOARD_ENABLED=true
FEATURE_DASHBOARD_ENABLED=true

# ============================================================================
# Security Configuration
# ============================================================================

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
