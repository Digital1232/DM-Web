# AI Awards for Creativity Recognition System
# Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# NODE ENVIRONMENT
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Connection
DATABASE_URL=postgresql://user:password@localhost:5432/ai_awards_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_awards_db
DB_USER=ai_awards_user
DB_PASSWORD=your_secure_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis Cache Layer
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_LEADERBOARD_TTL_MS=3600000
REDIS_STATS_TTL_MS=86400000
REDIS_DASHBOARD_TTL_MS=7200000

# =============================================================================
# JIRA INTEGRATION
# =============================================================================
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_API_TOKEN=your_jira_api_token
JIRA_USERNAME=your_email@company.com
JIRA_POLL_INTERVAL_MS=3600000
JIRA_SUBMISSION_DETECTION_LOOKBACK_MINUTES=90
JIRA_API_TIMEOUT_MS=30000
JIRA_RETRY_MAX_ATTEMPTS=3
JIRA_RETRY_BACKOFF_MS=60000,300000,900000

# =============================================================================
# AI VISION MODEL CONFIGURATION
# =============================================================================
# Primary AI Provider (Google Cloud Vision)
AI_PROVIDER_PRIMARY=google_cloud_vision
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key
GOOGLE_VISION_API_TIMEOUT_MS=120000

# Secondary AI Provider (Azure Computer Vision)
AI_PROVIDER_SECONDARY=azure_computer_vision
AZURE_VISION_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_VISION_API_KEY=your_azure_api_key
AZURE_VISION_API_TIMEOUT_MS=120000

# AI Evaluation Retry Configuration
AI_EVALUATION_MAX_RETRIES=3
AI_EVALUATION_RETRY_DELAY_MS=21600000
AI_EVALUATION_QUEUE_CONCURRENT_LIMIT=5

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================
# Email Service
NOTIFICATION_EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
NOTIFICATION_EMAIL_FROM=awards@company.com
NOTIFICATION_EMAIL_REPLY_TO=support@company.com

# In-App Notifications
NOTIFICATION_INAPP_ENABLED=true

# Slack Integration (Optional)
NOTIFICATION_SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=your_slack_bot_token

# Notification Timing
NOTIFICATION_SEND_DELAY_MS=300000
NOTIFICATION_DEDUP_WINDOW_MS=60000

# =============================================================================
# SUBMISSION DETECTION
# =============================================================================
SUBMISSION_DETECTION_SCHEDULE=0 * * * *
SUBMISSION_DUPLICATE_CHECK_ENABLED=true
SUBMISSION_MAX_FILE_SIZE_VIDEO_MB=500
SUBMISSION_MAX_FILE_SIZE_POSTER_MB=50
SUBMISSION_SUPPORTED_VIDEO_FORMATS=mp4,mov,webm
SUBMISSION_SUPPORTED_POSTER_FORMATS=png,jpg,jpeg,svg

# =============================================================================
# AWARD CALCULATION
# =============================================================================
AWARD_WEEKLY_CALCULATION_SCHEDULE=59 23 * * 0
AWARD_MONTHLY_CALCULATION_SCHEDULE=59 23 L * *
AWARD_COMPOSITION_WEIGHT=0.35
AWARD_COLOR_THEORY_WEIGHT=0.35
AWARD_BALANCE_WEIGHT=0.30
AWARD_SCORE_ROUNDING_TOLERANCE=1

# =============================================================================
# MEDIA STORAGE
# =============================================================================
MEDIA_STORAGE_TYPE=local
MEDIA_STORAGE_LOCAL_PATH=./media_cache
MEDIA_STORAGE_CACHE_TTL_MS=86400000

# If using cloud storage (Google Cloud Storage, AWS S3, Azure Blob)
# MEDIA_STORAGE_TYPE=gcs
# MEDIA_STORAGE_GCS_BUCKET=your-bucket-name
# MEDIA_STORAGE_GCS_PROJECT_ID=your-project-id

# =============================================================================
# AUDIT AND LOGGING
# =============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=730
AUDIT_LOG_BATCH_SIZE=100
LOG_FORMAT=json
LOG_OUTPUT=console,file
LOG_FILE_PATH=./logs/ai-awards.log
LOG_FILE_MAX_SIZE_MB=100
LOG_FILE_RETENTION_DAYS=30

# =============================================================================
# DATA EXPORT
# =============================================================================
EXPORT_MAX_RECORDS_PER_BATCH=1000
EXPORT_TEMP_FILE_TTL_MS=3600000
EXPORT_PDF_INCLUDE_CHARTS=true

# =============================================================================
# PERFORMANCE AND LIMITS
# =============================================================================
# Leaderboard
LEADERBOARD_PAGE_SIZE=10
LEADERBOARD_MAX_CONCURRENT_USERS=100

# Dashboard
DASHBOARD_REFRESH_INTERVAL_MS=7200000
DASHBOARD_CHART_MAX_POINTS=365

# API Rate Limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS_PER_WINDOW=100

# Timeout Settings
API_TIMEOUT_MS=30000
LONG_RUNNING_OPERATION_TIMEOUT_MS=300000

# =============================================================================
# TESTING AND DEVELOPMENT
# =============================================================================
# Feature Flags
FEATURE_FLAG_AWARD_NOTIFICATIONS=true
FEATURE_FLAG_LEADERBOARD_DISPLAY=true
FEATURE_FLAG_DASHBOARD_DISPLAY=true
FEATURE_FLAG_DATA_EXPORT=true
FEATURE_FLAG_JIRA_INTEGRATION=true

# Test Configuration
TEST_MODE=false
TEST_JIRA_MOCK_RESPONSES=false
TEST_AI_MODEL_MOCK_RESPONSES=false
TEST_NOTIFICATION_DRY_RUN=false

# =============================================================================
# SECURITY
# =============================================================================
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRY_HOURS=24
API_KEY_VALIDATION_ENABLED=true
CORS_ORIGIN=http://localhost:3000
HTTPS_ENFORCED=false

# =============================================================================
# MONITORING AND HEALTH CHECK
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=300000
METRICS_ENABLED=true
METRICS_PORT=9090
