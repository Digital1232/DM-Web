{
  "rules": {
    "worksync": {
      ".read": "auth != null",
      ".write": "auth != null",
      "attendance_events": {
        ".indexOn": ["userId", "date", "timestamp", "type"],
        "$eventId": {
          ".validate": "newData.hasChildren(['userId', 'type', 'timestamp'])",
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "users": {
        ".indexOn": ["email", "role"],
        "$userId": {
          ".read": true,
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "tasks": {
        ".indexOn": ["status", "assignee", "duedate", "priority"],
        "$taskId": {
          ".read": true,
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "discussions": {
        ".indexOn": ["status", "createdAt", "userId"],
        "$discussionId": {
          ".read": true,
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "timelogs": {
        ".indexOn": ["endTime", "startTime", "userId"],
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "task_notifications": {
        ".indexOn": ["timestamp"],
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "fcm_tokens": {
        "$userKey": {
          ".read": "auth != null",
          ".write": "auth != null && ($userKey == auth.uid || auth.token.email != null)"
        }
      },
      "requests": {
        ".indexOn": ["status", "userId", "timestamp"],
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "monthly_plans": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "daily_plans": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "conversations": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "messages": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$convId": {
          ".indexOn": ["timestamp"],
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "manual_tasks": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "strategy_events": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "dpr_entries": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "qc_reports": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "settings": {
        ".read": "auth != null",
        ".write": "auth != null"
        ".write": "auth != null",
        "email_reports_enabled": {
          ".write": "auth != null && (auth.token.email == 'digitalmarketing@vilpower.com' || auth.token.email == 'nanjil@vilpower.com' || auth.token.email == 'murugeshvilpower@gmail.com' || auth.token.email == 'murugesh@vilpower.com')"
        },
        "jira_project_mappings": {
          ".write": "auth != null && (auth.token.email == 'digitalmarketing@vilpower.com' || auth.token.email == 'nanjil@vilpower.com' || auth.token.email == 'murugeshvilpower@gmail.com' || auth.token.email == 'murugesh@vilpower.com')"
        },
        "jira_active_project_key": {
          ".write": "auth != null && (auth.token.email == 'digitalmarketing@vilpower.com' || auth.token.email == 'nanjil@vilpower.com' || auth.token.email == 'murugeshvilpower@gmail.com' || auth.token.email == 'murugesh@vilpower.com')"
        },
        "shift": {
          ".write": "auth != null && (auth.token.email == 'digitalmarketing@vilpower.com' || auth.token.email == 'nanjil@vilpower.com' || auth.token.email == 'murugeshvilpower@gmail.com' || auth.token.email == 'murugesh@vilpower.com')"
        }
      },
      "monthly_organisers": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
