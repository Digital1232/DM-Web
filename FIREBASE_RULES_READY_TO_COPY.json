{
  "rules": {
    "worksync": {
      ".read": "auth != null",
      ".write": "auth != null",
      "attendance_events": {
        ".indexOn": ["userId", "date", "timestamp", "type"],
        "$eventId": {
          ".validate": "newData.hasChildren(['userId', 'type', 'timestamp'])",
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "users": {
        ".indexOn": ["email", "role"],
        "$userId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "tasks": {
        ".indexOn": ["status", "assignee", "duedate", "priority"],
        "$taskId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "discussions": {
        ".indexOn": ["status", "createdAt", "userId"],
        "$discussionId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "requests": {
        ".indexOn": ["status", "userId", "timestamp"],
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "monthly_plans": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "daily_plans": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "conversations": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "messages": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "manual_tasks": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "strategy_events": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "dpr_entries": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "qc_reports": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "settings": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "monthly_organisers": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
