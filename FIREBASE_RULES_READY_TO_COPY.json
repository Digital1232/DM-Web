{
  "rules": {
    "worksync": {
      "attendance_events": {
        ".indexOn": ["userId", "date", "timestamp", "type"],
        "$eventId": {
          ".validate": "newData.hasChildren(['userId', 'type', 'timestamp'])",
          ".read": "auth != null",
          ".write": "auth != null"
        }
      },
      "users": {
        ".indexOn": ["email", "role"],
        "$userId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "tasks": {
        ".indexOn": ["status", "assignee", "duedate", "priority"],
        "$taskId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "discussions": {
        ".indexOn": ["status", "createdAt", "userId"],
        "$discussionId": {
          ".read": true,
          ".write": "auth != null"
        }
      },
      "requests": {
        ".indexOn": ["status", "userId", "timestamp"],
        "$requestId": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
