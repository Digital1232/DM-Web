{
  "version": 2,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/google-drive/:path*",
      "destination": "/api/googleDrive.js"
    },
    {
      "source": "/api/googleDrive/:path*",
      "destination": "/api/googleDrive.js"
    },
    {
      "source": "/api/meta/:path*",
      "destination": "/api/meta.js"
    },
    {
      "source": "/api/jira/:path*",
      "destination": "/api/jira.js"
    },
    {
      "source": "/:path((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
